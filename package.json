{
  "name": "akoka-result-compiler",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node mini-services/api/index.js",
    "lint": "npx tsc --noEmit",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "seed": "node scripts/seed.js",
    "seed:fresh": "prisma db push --accept-data-loss --force-reset && node scripts/seed.js",
    "api": "node mini-services/api/index.js",
    "build:web": "npx expo export --platform web",
    "serve:web": "node mini-services/api/index.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@prisma/client": "^6.11.1",
    "@react-native-async-storage/async-storage": "2.1.0",
    "cors": "^2.8.5",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "express": "^4.21.0",
    "nativewind": "^4.1.23",
    "query-string": "^10.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.14.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.0",
    "babel-preset-expo": "~12.0.0",
    "prisma": "^6.11.1",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
